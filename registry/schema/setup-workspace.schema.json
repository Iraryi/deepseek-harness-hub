{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Iraryi/deepseek-harness-hub/raw/main/registry/schema/setup-workspace.schema.json",
  "title": "DeepSeek Harness Setup Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "publisher", "source", "targets", "components", "hooks", "receipts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "summary": { "type": "string", "maxLength": 500 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["git", "zip", "local", "generated"] },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "minLength": 1 },
        "subdirectory": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "git" } } },
          "then": { "required": ["repository", "ref"] }
        },
        {
          "if": { "properties": { "kind": { "const": "zip" } } },
          "then": { "required": ["url", "sha256"] }
        },
        {
          "if": { "properties": { "kind": { "const": "local" } } },
          "then": { "required": ["path"] }
        }
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["desktop", "hub"] }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "kind": { "enum": ["runtime", "package", "artifact", "command"] },
          "version": { "type": "string" },
          "required": { "type": "boolean" },
          "source": { "type": "string" },
          "manualDownload": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "scope", "defaultEnabled"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "scope": { "enum": ["desktop", "hub", "both"] },
          "defaultEnabled": { "type": "boolean" },
          "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "type"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
                "label": { "type": "string", "minLength": 1 },
                "type": { "enum": ["boolean", "string", "number", "choice", "path"] },
                "default": {},
                "choices": { "type": "array", "items": { "type": ["string", "number", "boolean"] } },
                "description": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workingDirectory": { "type": "string", "minLength": 1 },
        "commands": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "patches": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "overlays": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "install", "verify", "uninstall"],
      "properties": {
        "preflight": { "$ref": "#/$defs/commands" },
        "install": { "$ref": "#/$defs/commands" },
        "verify": { "$ref": "#/$defs/commands" },
        "uninstall": { "$ref": "#/$defs/commands" }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "rollback"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "directories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "rollback": { "type": "string", "minLength": 1 },
        "restart": { "enum": ["none", "desktop", "hub", "both"] }
      }
    },
    "declarations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "signature": { "enum": ["verified", "unsigned", "unknown"] },
        "administrator": { "type": "boolean" },
        "networkHosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "writesOutsideProfile": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
