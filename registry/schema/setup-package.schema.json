{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Iraryi/deepseek-harness-hub/raw/main/registry/schema/setup-package.schema.json",
  "title": "DeepSeek Harness Setup Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "summary", "version", "publisher", "kind", "categories", "source", "license", "compatibility", "trust", "requirements", "install"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "kind": { "enum": ["virtual", "standalone"] },
    "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "featured": { "type": "boolean" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "format": "uri", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "platforms", "architectures", "surfaces"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["windows", "linux", "macos", "web"] } },
        "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["x64", "arm64", "any"] } },
        "surfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["desktop", "hub", "both", "cli"] } }
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "review"],
      "properties": {
        "signature": { "enum": ["verified", "unsigned", "unknown"] },
        "review": { "enum": ["schema", "source", "install", "lifecycle"] },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["administrator", "restart", "networkHosts"],
      "properties": {
        "administrator": { "type": "boolean" },
        "restart": { "enum": ["none", "desktop", "hub", "system"] },
        "networkHosts": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "externalRuntimes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profile", "rollback"],
      "properties": {
        "mode": { "enum": ["dsh-cli", "release-asset", "source", "manual"] },
        "profile": { "enum": ["desktop", "hub", "both"] },
        "command": { "type": "string", "minLength": 1 },
        "rollback": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
