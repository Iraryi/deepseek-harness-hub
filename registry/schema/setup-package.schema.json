{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Iraryi/deepseek-harness-hub/raw/main/registry/schema/setup-package.schema.json",
  "title": "DeepSeek Harness Setup Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "version",
    "kind",
    "categories",
    "tags",
    "source",
    "compatibility",
    "license",
    "signature",
    "audit",
    "artifacts",
    "install",
    "permissions",
    "network"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["virtual", "executable"] },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "source": { "$ref": "#/$defs/source" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "license": { "$ref": "#/$defs/license" },
    "signature": { "$ref": "#/$defs/signature" },
    "audit": { "$ref": "#/$defs/audit" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "install": { "$ref": "#/$defs/install" },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "network": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "virtual" } } },
      "then": { "properties": { "install": { "properties": { "mode": { "const": "profile" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "executable" } } },
      "then": { "properties": { "install": { "properties": { "mode": { "const": "executable" } } } } }
    }
  ],
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["default"],
          "properties": {
            "default": { "type": "string", "minLength": 1 },
            "zh": { "type": "string", "minLength": 1 },
            "en": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://" },
        "ref": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "release": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsh", "surfaces"],
      "properties": {
        "dsh": { "type": "string", "minLength": 1 },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cli", "web", "desktop"] }
        },
        "node": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["windows-x64", "windows-arm64", "any"] }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "name", "redistributable"],
      "properties": {
        "identifier": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "notice": { "type": "string" },
        "redistributable": { "type": "boolean" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["valid", "invalid", "unsigned", "unknown"] },
        "type": { "enum": ["authenticode", "sigstore", "minisign", "other"] },
        "signer": { "type": "string" },
        "issuer": { "type": "string" },
        "thumbprint": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checks"],
      "properties": {
        "status": { "enum": ["certified", "reviewed", "unreviewed", "rejected"] },
        "auditor": { "type": "string" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "report": { "type": "string" },
        "checks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "component"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "in-box" },
            "component": { "type": "string", "minLength": 1 },
            "platform": { "enum": ["windows-x64", "windows-arm64", "any"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "url", "sha256"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["package", "archive", "installer"] },
            "url": { "type": "string", "pattern": "^https://" },
            "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            "fileName": { "type": "string", "minLength": 1, "pattern": "^[^<>:\"/\\\\|?*\\\\u0000-\\\\u001F]+$" },
            "bytes": { "type": "integer", "minimum": 0 },
            "platform": { "enum": ["windows-x64", "windows-arm64", "any"] },
            "executable": { "type": "boolean" }
          }
        }
      ]
    },
    "install": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "artifactId"],
          "properties": {
            "mode": { "const": "profile" },
            "source": { "const": "package" },
            "artifactId": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "source", "bundle"],
          "properties": {
            "mode": { "const": "profile" },
            "source": { "const": "in-box" },
            "bundle": { "type": "string", "minLength": 1 },
            "profile": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "artifactId"],
          "properties": {
            "mode": { "const": "executable" },
            "artifactId": { "type": "string", "minLength": 1 },
            "silentArgs": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
