{
  "schemaVersion": 1,
  "id": "example-community-plugin",
  "name": {
    "default": "Example Community Plugin",
    "en": "Example Community Plugin",
    "zh": "社区插件示例"
  },
  "description": {
    "default": "Minimal virtual Setup example for a DSH plugin.",
    "en": "Minimal virtual Setup example for a DSH plugin.",
    "zh": "用于 DSH 插件的最小虚拟 Setup 示例。"
  },
  "version": "1.0.0",
  "kind": "virtual",
  "categories": ["development"],
  "tags": ["example", "plugin"],
  "source": {
    "repository": "https://github.com/example/dsh-plugin",
    "ref": "v1.0.0",
    "release": "v1.0.0"
  },
  "compatibility": {
    "dsh": ">=0.1.0",
    "surfaces": ["desktop"],
    "platforms": ["any"]
  },
  "license": {
    "identifier": "MIT",
    "name": "MIT License",
    "url": "https://github.com/example/dsh-plugin/blob/main/LICENSE",
    "redistributable": true
  },
  "signature": { "status": "unknown" },
  "audit": {
    "status": "unreviewed",
    "checks": ["manifest example only"]
  },
  "artifacts": [
    {
      "id": "source-archive",
      "kind": "archive",
      "url": "https://github.com/example/dsh-plugin/archive/refs/tags/v1.0.0.tar.gz",
      "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "fileName": "example-community-plugin-v1.0.0.tar.gz",
      "platform": "any"
    }
  ],
  "install": {
    "mode": "profile",
    "source": "package",
    "artifactId": "source-archive",
    "profile": "web"
  },
  "permissions": ["modify the selected DSH profile"],
  "network": ["github.com"]
}
